.venv/
venv/
.env
.env.*
!.env.example
!.env.*.example

# Test, coverage, and tool caches
.coverage
.coverage.*
coverage.xml
htmlcov/
.pytest_cache/
.ruff_cache/
.ty_cache/
.mypy_cache/
.hypothesis/
.tox/
.nox/

# IDE and operating-system files
.idea/
.vscode/
.DS_Store
Thumbs.db
*.swp
*~

