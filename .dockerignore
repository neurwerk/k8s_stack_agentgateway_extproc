# Version control and automation
.git/
.github/
.gitignore

# Python environments, bytecode, and build output
.venv/
venv/
**/__pycache__/
**/*.py[cod]
build/
dist/
*.egg-info/

# Tests, coverage, and tool caches
tests/
.coverage
.coverage.*
coverage.xml
htmlcov/
.pytest_cache/
.ruff_cache/
.ty_cache/
.mypy_cache/
.hypothesis/
.tox/
.nox/

# Local configuration, IDE, and operating-system files
.env
.env.*
.idea/
.vscode/
.DS_Store
Thumbs.db
*.swp
*~

# Local TLS identity material. Public certificate files are not blanket-ignored.
.certs/
.tls/
certs/local/
tls/local/
*.key
*.p12
*.pfx
*.jks
*.keystore
*.csr
*-key.pem
*_key.pem
*.private.pem
